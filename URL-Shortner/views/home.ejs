<!DOCTYPE html>
<html lang="en">
<head>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            margin: 0;
            padding: 40px 20px;
            color: #333;
        }

        h1 {
            text-align: center;
            color: #ffffff;
            font-size: 2.2rem;
            margin-bottom: 30px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2);
        }

        p {
            max-width: 600px;
            margin: 0 auto 20px auto;
            background: #e8f5e9;
            border: 1px solid #a5d6a7;
            color: #2e7d32;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 0.95rem;
            word-break: break-all;
        }

        div {
            max-width: 700px;
            margin: 0 auto;
        }

        form {
            background: #ffffff;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 30px;
        }

        form label {
            font-weight: 600;
            color: #444;
            width: 100%;
        }

        form input[type="text"] {
            flex: 1;
            min-width: 200px;
            padding: 12px 14px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s ease;
        }

        form input[type="text"]:focus {
            border-color: #764ba2;
        }

        form button {
            padding: 12px 24px;
            background: #764ba2;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        form button:hover {
            background: #5e3a85;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }

        thead {
            background: #764ba2;
        }

        thead th {
            color: #fff;
            padding: 14px;
            text-align: left;
            font-size: 0.95rem;
        }

        tbody tr {
            border-bottom: 1px solid #eee;
        }

        tbody tr:last-child {
            border-bottom: none;
        }

        tbody tr:hover {
            background: #f5f0fa;
        }

        tbody td {
            padding: 12px 14px;
            font-size: 0.9rem;
            word-break: break-all;
        }
    </style>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
</head>
<body>

<h1>URL Shortner</h1>
<% if( locals.id) { %>
    <p>URL Generated: http://localhost:8001/<%= id %>  </p>
    <%
} %>
<div>
<form method="POST" action="/url">
    <label >Enter Your Original URL</label>
    <input 
    type="text"
    name = "url"
    placeholder="https://example.com" />
    <button type="Submit">Generate</button>
</form>
</div>
<div>
    <% if (locals.urls) { %>
         <table>
            <thead>
                <th>S. No</th>
                <th>ShortID</th>
                <th>Redirect</th>
                <th>Clicks</th>
            </thead>
            <tbody>
                <% urls.forEach((url,index) => { %>
                    <tr>
                    <td><%= index + 1  %></td>
                    <td><%= url.shortID%></td>
                    <td><%= url.redirectURL %></td>
                    <td><%= url.visitHistory.length %></td>
                    </tr>
                <% }) %>
            </tbody>
         </table>
        <% 
    }
         %>
</div>
</body>
</html>
